<UserControl x:Class="SchoolSchedule.App.Views.CurriculumPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Loaded="CurriculumPage_OnLoaded"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Учебный план" Style="{StaticResource PageTitleStyle}" />
            <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Style="{StaticResource AppRaisedButton}"
                    Command="{Binding AddCommand}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Margin="0,0,8,0" />
                    <TextBlock Text="Добавить предмет" />
                </StackPanel>
            </Button>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Класс:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Medium" />
            <ComboBox Width="200" HorizontalAlignment="Left"
                      ItemsSource="{Binding AllClasses}"
                      SelectedItem="{Binding SelectedClass}"
                      DisplayMemberPath="Name" />
        </DockPanel>

        <materialDesign:Card Grid.Row="2" Padding="0">
            <DataGrid ItemsSource="{Binding Groups}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      RowEditEnding="DataGrid_OnRowEditEnding">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Предмет" Width="2.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Subject.Name}" VerticalAlignment="Center" Margin="8,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox Style="{StaticResource MaterialDesignComboBox}"
                                          ItemsSource="{Binding DataContext.AllSubjects, ElementName=Root}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="False" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Подгруппа (пусто = весь класс)"
                                         Binding="{Binding GroupLabel, UpdateSourceTrigger=PropertyChanged}" Width="2.5*" />
                    <DataGridTextColumn Header="Уроков/нед."
                                         Binding="{Binding LessonsPerWeek, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    <DataGridTextColumn Header="Уроков/день" ToolTipService.ToolTip="Максимум уроков этого предмета в один день. 1 — не больше одного в день; 2 и больше — при генерации расписания допускается несколько в один день (см. «Парные уроки»)."
                                         Binding="{Binding MaxLessonsPerDay, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    <DataGridCheckBoxColumn Header="Парные уроки" ToolTipService.ToolTip="Если в один день ставится больше одного урока этого предмета — идти подряд, без окна между ними. Работает только если «Уроков/день» больше 1."
                                             Binding="{Binding PairedLessons, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                    <DataGridTemplateColumn Header="" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding DataContext.DeleteCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Удалить строку">
                                    <materialDesign:PackIcon Kind="Delete" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
