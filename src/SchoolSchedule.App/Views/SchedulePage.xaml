<UserControl x:Class="SchoolSchedule.App.Views.SchedulePage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Loaded="SchedulePage_OnLoaded"
             d:DesignHeight="750" d:DesignWidth="1200">
    <UserControl.Resources>
        <Style x:Key="ScheduleHeaderCellStyle" TargetType="Border">
            <Setter Property="Padding" Value="6" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="ScheduleCellStyle" TargetType="Border">
            <Setter Property="Padding" Value="6" />
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Расписание" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,20" />

        <!-- Настройки сетки -->
        <materialDesign:Card Grid.Row="1" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Сетка расписания" Style="{StaticResource SectionLabelStyle}" />
                <WrapPanel>
                    <TextBox Width="140" Margin="0,0,12,0"
                             materialDesign:HintAssist.Hint="Дней в неделю (1-6)"
                             Text="{Binding DaysPerWeek, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Width="180" Margin="0,0,12,0"
                             materialDesign:HintAssist.Hint="Уроков в смену 1"
                             Text="{Binding PeriodsPerDayShift1, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="Есть вторая смена" VerticalAlignment="Center" Margin="0,0,12,0"
                              IsChecked="{Binding HasSecondShift}" />
                    <TextBox Width="180" Margin="0,0,12,0"
                             materialDesign:HintAssist.Hint="Уроков в смену 2"
                             Visibility="{Binding HasSecondShift, Converter={StaticResource BoolToVisibilityConverter}}"
                             Text="{Binding PeriodsPerDayShift2, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Сохранить настройки сетки" Style="{StaticResource AppOutlinedButton}"
                            VerticalAlignment="Center"
                            Command="{Binding SaveSettingsCommand}" />
                </WrapPanel>
                <TextBlock Margin="0,10,0,0" Opacity="0.65" TextWrapping="Wrap" FontSize="12"
                           Text="Изменение сетки удалит уже сгенерированное расписание — после сохранения нажмите «Сгенерировать» ещё раз." />
            </StackPanel>
        </materialDesign:Card>

        <!-- Правила генерации -->
        <materialDesign:Card Grid.Row="2" Padding="0" Margin="0,0,0,16">
            <Expander Header="Правила, по которым строится расписание">
                <StackPanel Margin="20,0,20,16">
                    <ItemsControl ItemsSource="{Binding GenerationRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock DockPanel.Dock="Left" Text="•" Margin="0,0,8,0" FontWeight="Bold" Opacity="0.6" />
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Opacity="0.85" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>
        </materialDesign:Card>

        <!-- Генерация -->
        <materialDesign:Card Grid.Row="3" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource AppRaisedButton}"
                            IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBoolConverter}}"
                            Command="{Binding GenerateCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarSync" Margin="0,0,8,0" />
                            <TextBlock Text="Сгенерировать расписание" />
                        </StackPanel>
                    </Button>
                    <ProgressBar DockPanel.Dock="Left" Margin="16,0,0,0" Width="120" Height="4" IsIndeterminate="True"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibilityConverter}}" />
                </DockPanel>

                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontWeight="Medium"
                           Text="{Binding StatusMessage}"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="#C0392B" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Opacity="0.8" FontSize="12" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </materialDesign:Card>

        <!-- Переключатель вида -->
        <DockPanel Grid.Row="4" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <RadioButton Content="По классам" GroupName="ScheduleView" Margin="0,0,20,0" VerticalAlignment="Center"
                             IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ByClass}" />
                <RadioButton Content="По учителям" GroupName="ScheduleView" Margin="0,0,20,0" VerticalAlignment="Center"
                             IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ByTeacher}" />
                <RadioButton Content="Общее (все классы)" GroupName="ScheduleView" Margin="0,0,20,0" VerticalAlignment="Center"
                             IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Overview}" />

                <ComboBox Width="220"
                          Visibility="{Binding IsByClassView, Converter={StaticResource BoolToVisibilityConverter}}"
                          ItemsSource="{Binding AllClasses}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedClassForView}" />
                <ComboBox Width="260"
                          Visibility="{Binding IsByTeacherView, Converter={StaticResource BoolToVisibilityConverter}}"
                          ItemsSource="{Binding AllTeachers}" DisplayMemberPath="FullName"
                          SelectedItem="{Binding SelectedTeacherForView}" />

                <TextBlock Text="День:" VerticalAlignment="Center" Margin="20,0,10,0" Opacity="0.7" />
                <ComboBox Width="160"
                          ItemsSource="{Binding DayFilterOptions}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedDayFilter}" />
            </StackPanel>
        </DockPanel>

        <!-- Сетка -->
        <materialDesign:Card Grid.Row="5" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.RowSpan="2" Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="Расписание ещё не сгенерировано — заполните учебный план и назначения, затем нажмите «Сгенерировать расписание»."
                           TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                           Visibility="{Binding HasGeneratedSchedule, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                <Grid Grid.Row="0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasGeneratedSchedule}" Value="True" />
                                        <Condition Binding="{Binding IsOverviewView}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource ScheduleHeaderCellStyle}" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding DayHeaders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ScheduleHeaderCellStyle}">
                                    <TextBlock Text="{Binding}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasGeneratedSchedule}" Value="True" />
                                        <Condition Binding="{Binding IsOverviewView}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding GridRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource ScheduleCellStyle}" Background="{DynamicResource MaterialDesignBackground}">
                                        <TextBlock Text="{Binding PeriodLabel}" VerticalAlignment="Center" FontWeight="Medium" TextWrapping="Wrap" />
                                    </Border>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ScheduleCellStyle}">
                                                    <StackPanel Visibility="{Binding SubjectName, Converter={StaticResource NullToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding SubjectName}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding SecondaryLine}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                        <TextBlock FontSize="11" Opacity="0.6" Margin="0,2,0,0">
                                                            <Run Text="Каб. " /><Run Text="{Binding RoomName, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Общее расписание: строка = день+урок, столбец = класс. Ширина столбцов
                     зафиксирована явно (а не поделена поровну через UniformGrid), иначе при
                     горизонтальной прокрутке колонки шапки и строк могут разъехаться. -->
                <ScrollViewer Grid.Row="0" Grid.RowSpan="2"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasGeneratedSchedule}" Value="True" />
                                        <Condition Binding="{Binding IsOverviewView}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ScheduleHeaderCellStyle}" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding AllClasses}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="150" Style="{StaticResource ScheduleHeaderCellStyle}">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding OverviewRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource ScheduleCellStyle}" Background="{DynamicResource MaterialDesignBackground}">
                                            <TextBlock Text="{Binding RowLabel}" VerticalAlignment="Center" FontWeight="Medium" TextWrapping="Wrap" />
                                        </Border>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding ClassCells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="150" Style="{StaticResource ScheduleCellStyle}">
                                                        <StackPanel Visibility="{Binding SubjectName, Converter={StaticResource NullToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding SubjectName}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding SecondaryLine}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                            <TextBlock FontSize="11" Opacity="0.6" Margin="0,2,0,0">
                                                                <Run Text="Каб. " /><Run Text="{Binding RoomName, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
