<Window x:Class="SchoolSchedule.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:SchoolSchedule.App"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="15"
        FontFamily="Segoe UI Variable Text, Segoe UI, Roboto"
        Background="{DynamicResource MaterialDesignBackground}"
        Title="Расписание школы" Height="800" Width="1360" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="284" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" materialDesign:ElevationAssist.Elevation="Dp4">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#5D4037" Offset="0" />
                    <GradientStop Color="#A1887F" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,28,24,22">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#26FFFFFF" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="CalendarBlank" Width="21" Height="21"
                                                  Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Расписание" FontSize="18" FontWeight="SemiBold" Foreground="White" LineHeight="20" />
                        <TextBlock Text="школы" FontSize="18" FontWeight="SemiBold" Foreground="White" LineHeight="20" />
                    </StackPanel>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="Sheldue · разработка" Foreground="#80FFFFFF" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,0,0,16" />

                <ListBox DockPanel.Dock="Bottom"
                         Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding NavigationView}"
                         SelectedItem="{Binding SelectedItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Margin="10,0,10,8">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignNavigationPrimaryListBoxItem}">
                            <Setter Property="Padding" Value="14,12" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="FontSize" Value="15" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Свой, гарантированно видимый фон выбранного пункта — не полагаемся на встроенный
                                 Material-оверлей: на тёмном градиенте произвольного цвета он бывает почти невидим. -->
                            <Border x:Name="ItemBackground" CornerRadius="10" Background="Transparent">
                                <Grid AutomationProperties.Name="{Binding Title}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="AccentBar" Grid.Column="0" Width="4" Height="18" CornerRadius="2"
                                            Background="White" Opacity="0" Margin="0,0,12,0" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="{Binding Icon}" Width="20" Height="20"
                                                                  VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="AccentBar" Property="Opacity" Value="1" />
                                    <Setter TargetName="ItemBackground" Property="Background" Value="#33FFFFFF" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                    <Setter TargetName="ItemBackground" Property="Background" Value="#1AFFFFFF" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="#80FFFFFF" FontSize="11" FontWeight="Bold"
                                               Margin="14,18,14,6" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </DockPanel>
        </Grid>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="32,28" />

        <materialDesign:Snackbar Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                  MessageQueue="{Binding SnackbarMessageQueue}" />
    </Grid>
</Window>
